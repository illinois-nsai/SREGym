n<tool_call>\n{"name": "exec_read_only_kubectl_cmd", "arguments": {"command": "kubectl describe pod custom-service-546dfb5d9-bszs7 -n hotel-reservation"}}\n</tool_call>', additional_kwargs={'provider_specific_fields': {'refusal': None, 'reasoning': None}}, response_metadata={'token_usage': Usage(completion_tokens=870, prompt_tokens=5507, total_tokens=6377, completion_tokens_details=None, prompt_tokens_details=None), 'model': 'openai/Qwen/Qwen3-8B', 'finish_reason': 'stop', 'logprobs': None, 'model_name': 'openai/Qwen/Qwen3-8B'}, id='lc_run--019cfd08-2d45-7892-8754-80cbe80bd98b-0', tool_calls=[], invalid_tool_calls=[], usage_metadata={'input_tokens': 5507, 'output_tokens': 870, 'total_tokens': 6377}), HumanMessage(content='Now generate a tool call according to your last chosen tool.', additional_kwargs={}, response_metadata={}, id='8b0ac35d-1ec4-4b5f-8f6a-24ec6f729e99')]]
