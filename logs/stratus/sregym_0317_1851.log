mand": "kubectl get pods -n astronomy-shop"}', 'name': 'exec_read_only_kubectl_cmd'}, 'id': 'chatcmpl-tool-b909a84082d18884', 'type': 'function'}], 'provider_specific_fields': {'reasoning': None, 'refusal': None}}, response_metadata={'token_usage': {'completion_tokens': 401, 'prompt_tokens': 5657, 'total_tokens': 6058, 'completion_tokens_details': None, 'prompt_tokens_details': None}, 'model': 'openai/Qwen/Qwen3-8B', 'finish_reason': 'tool_calls', 'logprobs': None, 'model_name': 'openai/Qwen/Qwen3-8B'}, id='lc_run--019cfd25-66a9-7a42-b772-3ee90fae65f9-0', tool_calls=[{'name': 'exec_read_only_kubectl_cmd', 'args': {'command': 'kubectl get pods -n astronomy-shop'}, 'id': 'chatcmpl-tool-b909a84082d18884', 'type': 'tool_call'}], invalid_tool_calls=[], usage_metadata={'input_tokens': 5657, 'output_tokens': 401, 'total_tokens': 6058}), ToolMessage(content='NAME                               READY   STATUS    RESTARTS        AGE\naccounting-844d99ddff-xztgp        1/1     Running   0               4m23s\nad-6f9964ffd8-qcddv                1/1     Running   0               4m23s\ncart-65474cd577-ds4dp              1/1     Running   0               4m23s\ncheckout-648b497649-tgg82          1/1     Running   0               4m22s\ncurrency-69f5b55bbc-sfl2k          1/1     Running   0               4m23s\nemail-56985bb4f8-kpnwc             1/1     Running   0               4m23s\nflagd-79c4c6cb44-m7stj             2/2     Running   0               4m20s\nfraud-detection-88b76487c-sptg8    1/1     Running   0               4m23s\nfrontend-65c7cd5577-b5xgj          1/1     Running   0               4m23s\nfrontend-proxy-84788b44b-srhzk     1/1     Running   0               4m21s\ngrafana-bdbfb995f-qc76w            4/4     Running   0               4m20s\nimage-provider-6c7d4665cc-6x55v    1/1     Running   0               4m23s\njaeger-6d6f47c768-cwnk8            1/1     Running   0               4m21s\nkafka-74ccb7b5fd-xrdxg             1/1     Running   0               4m22s\