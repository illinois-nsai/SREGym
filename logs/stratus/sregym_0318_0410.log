imits. But for now, checking the logs is the immediate next action.\n</think>\n\n', additional_kwargs={'tool_calls': [{'function': {'arguments': '{"command": "kubectl logs profile-69cb98cb67-47sxz -n hotel-reservation"}', 'name': 'exec_read_only_kubectl_cmd'}, 'id': 'chatcmpl-tool-a2a7868ee88e14f2', 'type': 'function'}], 'provider_specific_fields': {'refusal': None, 'reasoning': None}}, response_metadata={'token_usage': {'completion_tokens': 341, 'prompt_tokens': 6211, 'total_tokens': 6552, 'completion_tokens_details': None, 'prompt_tokens_details': None}, 'model': 'openai/Qwen/Qwen3-8B', 'finish_reason': 'tool_calls', 'logprobs': None, 'model_name': 'openai/Qwen/Qwen3-8B'}, id='lc_run--019cff24-309a-7e81-90e2-53edb1fbae8e-0', tool_calls=[{'name': 'exec_read_only_kubectl_cmd', 'args': {'command': 'kubectl logs profile-69cb98cb67-47sxz -n hotel-reservation'}, 'id': 'chatcmpl-tool-a2a7868ee88e14f2', 'type': 'tool_call'}], invalid_tool_calls=[], usage_metadata={'input_tokens': 6211, 'output_tokens': 341, 'total_tokens': 6552}), ToolMessage(content='{"level":"info","time":"2026-03-18T04:08:59Z","message":"TLS disabled."}\n{"level":"info","time":"2026-03-18T04:08:59Z","message":"Set global log level: info"}\n{"level":"info","time":"2026-03-18T04:08:59Z","message":"Tune: setGCPercent to 100"}\n\x1b[90m2026-03-18T04:08:59Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mcmd/profile/main.go:24\x1b[0m\x1b[36m >\x1b[0m \x1b[1mReading config...\x1b[0m\n\x1b[90m2026-03-18T04:08:59Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mcmd/profile/main.go:37\x1b[0m\x1b[36m >\x1b[0m \x1b[1mRead database URL: mongodb-profile:27017\x1b[0m\n\x1b[90m2026-03-18T04:08:59Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mcmd/profile/main.go:38\x1b[0m\x1b[36m >\x1b[0m \x1b[1mInitializing DB connection...\x1b[0m\n\x1b[90m2026-03-18T04:08:59Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mcmd/profile/db.go:36\x1b[0m\x1b[36m >\x1b[0m \x1b[1mNew session successfull...\x1b[0m\n\x1b[90m2026-03-18T04:08:59Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mcmd/profile/db.go:3