aving residual changes. Each call to rollback_command will undo the last operation, so we start with the most recent command.", additional_kwargs={'provider_specific_fields': {'reasoning': None, 'refusal': None}}, response_metadata={'token_usage': Usage(completion_tokens=538, prompt_tokens=777, total_tokens=1315, completion_tokens_details=None, prompt_tokens_details=None), 'model': 'openai/Qwen/Qwen3-8B', 'finish_reason': 'stop', 'logprobs': None, 'model_name': 'openai/Qwen/Qwen3-8B'}, id='lc_run--019cfc20-868d-7e21-86af-de8704b6960b-0', tool_calls=[], invalid_tool_calls=[], usage_metadata={'input_tokens': 777, 'output_tokens': 538, 'total_tokens': 1315}), HumanMessage(content='Now generate a tool call according to your last chosen tool.', additional_kwargs={}, response_metadata={}, id='25b62646-3720-4534-a555-a51ddafec4f6')]]
