n  ipFamilies:\n  - IPv4\n  ipFamilyPolicy: SingleStack\n  ports:\n  - name: jaeger-compact\n    port: 6831\n    protocol: UDP\n    targetPort: 6831\n  - name: jaeger-grpc\n    port: 14250\n    protocol: TCP\n    targetPort: 14250\n  - name: jaeger-thrift\n    port: 14268\n    protocol: TCP\n    targetPort: 14268\n  - name: metrics\n    port: 8888\n    protocol: TCP\n    targetPort: 8888\n  - name: otlp\n    port: 4317\n    protocol: TCP\n    targetPort: 4317\n  - name: otlp-http\n    port: 4318\n    protocol: TCP\n    targetPort: 4318\n  - name: zipkin\n    port: 9411\n    protocol: TCP\n    targetPort: 9411\n  selector:\n    app.kubernetes.io/instance: astronomy-shop\n    app.kubernetes.io/name: opentelemetry-collector\n    component: agent-collector\n  sessionAffinity: None\n  type: ClusterIP\nEOF'}, 'id': 'chatcmpl-tool-944a352b2b140ae1', 'type': 'tool_call'}], invalid_tool_calls=[], usage_metadata={'input_tokens': 11751, 'output_tokens': 1154, 'total_tokens': 12905}), ToolMessage(content='service/otel-collector configured\n', id='b559d5d8-154a-40bb-aa11-8eba1342f536', tool_call_id='chatcmpl-tool-944a352b2b140ae1'), HumanMessage(content='You are now in the thinking stage. Choose a tool from the available tools and justify your choice.', additional_kwargs={}, response_metadata={}, id='3e71bccb-5b36-4f3a-8df5-beaad2f0c509')]]
