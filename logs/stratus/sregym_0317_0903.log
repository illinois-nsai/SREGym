ile/main.go:51\x1b[0m\x1b[36m >\x1b[0m \x1b[1mRead consul address: consul:8500\x1b[0m\n\x1b[90m2026-03-17T09:02:36Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mcmd/profile/main.go:52\x1b[0m\x1b[36m >\x1b[0m \x1b[1mRead jaeger address: jaeger:6831\x1b[0m\n\x1b[90m2026-03-17T09:02:36Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mcmd/profile/main.go:61\x1b[0m\x1b[36m >\x1b[0m \x1b[1mInitializing jaeger agent [service name: profile | host: jaeger:6831]...\x1b[0m\n\x1b[90m2026-03-17T09:02:36Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mtracing/tracer.go:26\x1b[0m\x1b[36m >\x1b[0m \x1b[1mJaeger client: adjusted sample ratio 1.000000\x1b[0m\n\x1b[90m2026-03-17T09:02:36Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mcmd/profile/main.go:66\x1b[0m\x1b[36m >\x1b[0m \x1b[1mJaeger agent initialized\x1b[0m\n\x1b[90m2026-03-17T09:02:36Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mcmd/profile/main.go:68\x1b[0m\x1b[36m >\x1b[0m \x1b[1mInitializing consul agent [host: consul:8500]...\x1b[0m\n\x1b[90m2026-03-17T09:02:36Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mcmd/profile/main.go:73\x1b[0m\x1b[36m >\x1b[0m \x1b[1mConsul agent initialized\x1b[0m\n\x1b[90m2026-03-17T09:02:36Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mcmd/profile/main.go:85\x1b[0m\x1b[36m >\x1b[0m \x1b[1mStarting server...\x1b[0m\n\x1b[90m2026-03-17T09:02:36Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mregistry/registry.go:91\x1b[0m\x1b[36m >\x1b[0m \x1b[1mTrying to register service [ name: srv-profile, id: f75bed2d-e43d-43cd-97fb-b9ac5c4c9f9d, address: 10.244.1.84:8081 ]\x1b[0m\n\x1b[90m2026-03-17T09:02:36Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mservices/profile/server.go:99\x1b[0m\x1b[36m >\x1b[0m \x1b[1mSuccessfully registered in consul\x1b[0m\n', id='96bd420f-415f-4706-a9b8-be883722f618', tool_call_id='chatcmpl-tool-b3c4a521025ff194'), HumanMessage(content='You are now in the thinking stage. Choose a tool from the available tools and justify your choice.', additional_kwargs={}, response_metadata={}, id='219ea219-5426-4ecf-9e64-12077f8f8828')]]
