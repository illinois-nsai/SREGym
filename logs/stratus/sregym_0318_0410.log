x1b[1mcmd/geo/main.go:47\x1b[0m\x1b[36m >\x1b[0m \x1b[1mRead jaeger address: jaeger:6831\x1b[0m\n\x1b[90m2026-03-18T04:08:48Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mcmd/geo/main.go:55\x1b[0m\x1b[36m >\x1b[0m \x1b[1mInitializing jaeger agent [service name: geo | host: jaeger:6831]...\x1b[0m\n\x1b[90m2026-03-18T04:08:48Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mtracing/tracer.go:26\x1b[0m\x1b[36m >\x1b[0m \x1b[1mJaeger client: adjusted sample ratio 1.000000\x1b[0m\n\x1b[90m2026-03-18T04:08:48Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mcmd/geo/main.go:61\x1b[0m\x1b[36m >\x1b[0m \x1b[1mJaeger agent initialized\x1b[0m\n\x1b[90m2026-03-18T04:08:48Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mcmd/geo/main.go:63\x1b[0m\x1b[36m >\x1b[0m \x1b[1mInitializing consul agent [host: consul:8500]...\x1b[0m\n\x1b[90m2026-03-18T04:08:48Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mcmd/geo/main.go:68\x1b[0m\x1b[36m >\x1b[0m \x1b[1mConsul agent initialized\x1b[0m\n\x1b[90m2026-03-18T04:08:48Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mcmd/geo/main.go:79\x1b[0m\x1b[36m >\x1b[0m \x1b[1mStarting server...\x1b[0m\n\x1b[90m2026-03-18T04:08:48Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mregistry/registry.go:91\x1b[0m\x1b[36m >\x1b[0m \x1b[1mTrying to register service [ name: srv-geo, id: 227e6671-b5a7-4d81-a3f4-848d2dde70c1, address: 10.244.0.223:8083 ]\x1b[0m\n\x1b[90m2026-03-18T04:08:48Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mservices/geo/server.go:110\x1b[0m\x1b[36m >\x1b[0m \x1b[1mSuccessfully registered in consul\x1b[0m\n', id='0572d2ac-4d38-4f64-9a31-b5b83b3bf9c4', tool_call_id='chatcmpl-tool-b8b1098f2c0d15bb'), HumanMessage(content='You are now in the thinking stage. Choose a tool from the available tools and justify your choice.', additional_kwargs={}, response_metadata={}, id='fc6c4d72-69a8-42ae-b689-020bbfcedf80')]]
