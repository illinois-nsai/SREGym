0m2026-03-17T14:07:16Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mcmd/rate/main.go:73\x1b[0m\x1b[36m >\x1b[0m \x1b[1mConsul agent initialized\x1b[0m\n\x1b[90m2026-03-17T14:07:16Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mcmd/rate/main.go:85\x1b[0m\x1b[36m >\x1b[0m \x1b[1mStarting server...\x1b[0m\n\x1b[90m2026-03-17T14:07:16Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mregistry/registry.go:91\x1b[0m\x1b[36m >\x1b[0m \x1b[1mTrying to register service [ name: srv-rate, id: a4bda695-dd7d-4615-8156-f599e977295d, address: 10.244.0.41:8084 ]\x1b[0m\n\x1b[90m2026-03-17T14:07:16Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mservices/rate/server.go:99\x1b[0m\x1b[36m >\x1b[0m \x1b[1mSuccessfully registered in consul\x1b[0m\n', id='52dcc4f8-e986-4a51-ad98-7b3034210f85', tool_call_id='chatcmpl-tool-ac8dd11f3594d7af'), HumanMessage(content='You are now in the thinking stage. Choose a tool from the available tools and justify your choice.', additional_kwargs={}, response_metadata={}, id='636c1275-8748-4bb1-bdc3-3505ef8d1df7')]]
