ponse_metadata={'token_usage': Usage(completion_tokens=338, prompt_tokens=5691, total_tokens=6029, completion_tokens_details=None, prompt_tokens_details=None), 'model': 'openai/Qwen/Qwen3-8B', 'finish_reason': 'stop', 'logprobs': None, 'model_name': 'openai/Qwen/Qwen3-8B'}, id='lc_run--019cfbec-9fa7-7a52-93e1-6f3e2eac2ebb-0', tool_calls=[], invalid_tool_calls=[], usage_metadata={'input_tokens': 5691, 'output_tokens': 338, 'total_tokens': 6029}), HumanMessage(content='Now generate a tool call according to your last chosen tool.', additional_kwargs={}, response_metadata={}, id='f6c86c08-3202-482b-9a98-fe823fb58080')]]
