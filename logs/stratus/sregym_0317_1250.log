one}}, response_metadata={'token_usage': {'completion_tokens': 496, 'prompt_tokens': 18058, 'total_tokens': 18554, 'completion_tokens_details': None, 'prompt_tokens_details': None}, 'model': 'openai/Qwen/Qwen3-8B', 'finish_reason': 'stop', 'logprobs': None, 'model_name': 'openai/Qwen/Qwen3-8B'}, id='lc_run--019cfbdd-b17e-7b30-ae36-a8b2b0e9c60f-0', tool_calls=[], invalid_tool_calls=[], usage_metadata={'input_tokens': 18058, 'output_tokens': 496, 'total_tokens': 18554}), HumanMessage(content='You are now in the thinking stage. Choose a tool from the available tools and justify your choice.', additional_kwargs={}, response_metadata={}, id='679b5264-7112-4b66-8ac7-7e244de0684d')]]
