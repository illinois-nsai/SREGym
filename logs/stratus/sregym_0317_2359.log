at the 'reservation' service isn't getting endpoints despite correct configurations, indicating a problem with service discovery or network policies in Kubernetes.\n</think>\n\n", additional_kwargs={'tool_calls': [{'function': {'arguments': '{"command": "kubectl -n hotel-reservation logs reservation-7bb77b596b-8zbb6"}', 'name': 'exec_kubectl_cmd_safely'}, 'id': 'chatcmpl-tool-a10d3b57f957ef82', 'type': 'function'}], 'provider_specific_fields': {'reasoning': None, 'refusal': None}}, response_metadata={'token_usage': {'completion_tokens': 407, 'prompt_tokens': 5907, 'total_tokens': 6314, 'completion_tokens_details': None, 'prompt_tokens_details': None}, 'model': 'openai/Qwen/Qwen3-8B', 'finish_reason': 'tool_calls', 'logprobs': None, 'model_name': 'openai/Qwen/Qwen3-8B'}, id='lc_run--019cfe41-4991-7d50-a8ef-88b438e09e35-0', tool_calls=[{'name': 'exec_kubectl_cmd_safely', 'args': {'command': 'kubectl -n hotel-reservation logs reservation-7bb77b596b-8zbb6'}, 'id': 'chatcmpl-tool-a10d3b57f957ef82', 'type': 'tool_call'}], invalid_tool_calls=[], usage_metadata={'input_tokens': 5907, 'output_tokens': 407, 'total_tokens': 6314}), ToolMessage(content='{"level":"info","time":"2026-03-17T23:58:48Z","message":"TLS disabled."}\n{"level":"info","time":"2026-03-17T23:58:48Z","message":"Set global log level: info"}\n{"level":"info","time":"2026-03-17T23:58:48Z","message":"Tune: setGCPercent to 100"}\n\x1b[90m2026-03-17T23:58:48Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mcmd/reservation/main.go:25\x1b[0m\x1b[36m >\x1b[0m \x1b[1mReading config...\x1b[0m\n\x1b[90m2026-03-17T23:58:48Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mcmd/reservation/main.go:38\x1b[0m\x1b[36m >\x1b[0m \x1b[1mRead database URL: mongodb-reservation:27017\x1b[0m\n\x1b[90m2026-03-17T23:58:48Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mcmd/reservation/main.go:39\x1b[0m\x1b[36m >\x1b[0m \x1b[1mInitializing DB connection...\x1b[0m\n\x1b[90m2026-03-17T23:58:48Z\x1b[0m \x1b[32mINF\x1b[0m \x1b[1mcmd/reservation/db.go:30\x1b[0m\x1b[36m >\x1b[0m \x1b[