s": {"last_n_minutes": 15}}\n</tool_call>', additional_kwargs={'provider_specific_fields': {'refusal': None, 'reasoning': None}}, response_metadata={'token_usage': Usage(completion_tokens=547, prompt_tokens=16505, total_tokens=17052, completion_tokens_details=None, prompt_tokens_details=None), 'model': 'openai/Qwen/Qwen3-8B', 'finish_reason': 'stop', 'logprobs': None, 'model_name': 'openai/Qwen/Qwen3-8B'}, id='lc_run--019cfaf0-4859-7121-b2a8-6b535ee9d7f6-0', tool_calls=[], invalid_tool_calls=[], usage_metadata={'input_tokens': 16505, 'output_tokens': 547, 'total_tokens': 17052}), HumanMessage(content='Now generate a tool call according to your last chosen tool.', additional_kwargs={}, response_metadata={}, id='0affc03b-edc3-4934-8330-3425b48332af')]]
