age': Usage(completion_tokens=746, prompt_tokens=11015, total_tokens=11761, completion_tokens_details=None, prompt_tokens_details=None), 'model': 'openai/Qwen/Qwen3-8B', 'finish_reason': 'stop', 'logprobs': None, 'model_name': 'openai/Qwen/Qwen3-8B'}, id='lc_run--019cfd41-e8f5-7503-9e03-569caa348a9f-0', tool_calls=[], invalid_tool_calls=[], usage_metadata={'input_tokens': 11015, 'output_tokens': 746, 'total_tokens': 11761}), HumanMessage(content='Now generate a tool call according to your last chosen tool.', additional_kwargs={}, response_metadata={}, id='4f51900e-c45f-49a8-b873-aa9fa57b885d')]]
