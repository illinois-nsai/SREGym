ariable interpolation, so fixing that should resolve the CrashLoopBackOff.\n</think>\n\n', additional_kwargs={'tool_calls': [{'function': {'arguments': '{"command": "kubectl get pods -n hotel-reservation"}', 'name': 'exec_kubectl_cmd_safely'}, 'id': 'chatcmpl-tool-b4491859b1508673', 'type': 'function'}], 'provider_specific_fields': {'reasoning': None, 'refusal': None}}, response_metadata={'token_usage': {'completion_tokens': 685, 'prompt_tokens': 19227, 'total_tokens': 19912, 'completion_tokens_details': None, 'prompt_tokens_details': None}, 'model': 'openai/Qwen/Qwen3-8B', 'finish_reason': 'tool_calls', 'logprobs': None, 'model_name': 'openai/Qwen/Qwen3-8B'}, id='lc_run--019cfad3-6f4c-7643-861d-41ffb23b328c-0', tool_calls=[{'name': 'exec_kubectl_cmd_safely', 'args': {'command': 'kubectl get pods -n hotel-reservation'}, 'id': 'chatcmpl-tool-b4491859b1508673', 'type': 'tool_call'}], invalid_tool_calls=[], usage_metadata={'input_tokens': 19227, 'output_tokens': 685, 'total_tokens': 19912}), ToolMessage(content='NAME                                     READY   STATUS             RESTARTS        AGE\nconsul-5c696cc4dc-6s4xr                  1/1     Running            0               9m36s\nfrontend-6df8475df4-qcb4d                1/1     Running            0               9m36s\ngeo-57c7bd6d5c-s9b66                     1/1     Running            2 (8m43s ago)   9m35s\njaeger-5b9775bd94-hgczs                  1/1     Running            0               9m32s\nmemcached-profile-6849578b8-hgpdc        1/1     Running            0               9m29s\nmemcached-rate-948594dfd-qlwq9           1/1     Running            0               9m24s\nmemcached-reserve-68dbb57476-8644q       1/1     Running            0               9m13s\nmongodb-geo-5d9cf968b9-ztqrl             0/1     CrashLoopBackOff   5 (114s ago)    7m10s\nmongodb-profile-76fb8d4b68-nl5tj         0/1     CrashLoopBackOff   5 (119s ago)    7m8s\nmongodb-rate-b9589b8d-n67gv              0/1     CrashLoopBackOff   