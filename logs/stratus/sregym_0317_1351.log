rontend pod. This will verify if the path is correctly exposed or if there\'s a misconfiguration in the application.\n\ntool_call: {"command": "kubectl exec -it frontend-55df67b4b9-k9rmj -n astronomy-shop -- curl -s http://localhost:8080/healthz"}', additional_kwargs={'provider_specific_fields': {'refusal': None, 'reasoning': None}}, response_metadata={'token_usage': Usage(completion_tokens=722, prompt_tokens=6129, total_tokens=6851, completion_tokens_details=None, prompt_tokens_details=None), 'model': 'openai/Qwen/Qwen3-8B', 'finish_reason': 'stop', 'logprobs': None, 'model_name': 'openai/Qwen/Qwen3-8B'}, id='lc_run--019cfc13-3ed7-7000-be4f-ef470d979b0f-0', tool_calls=[], invalid_tool_calls=[], usage_metadata={'input_tokens': 6129, 'output_tokens': 722, 'total_tokens': 6851}), HumanMessage(content='Now generate a tool call according to your last chosen tool.', additional_kwargs={}, response_metadata={}, id='c5d775a8-153d-4f1c-b723-747495f81104')]]
