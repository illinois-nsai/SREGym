ate, and the `MONGO_URI` is not being used by the application. This indicates the app is not parsing the `MONGO_URI` environment variable or the Secret values are not correctly injected. To resolve this, we need to explicitly ensure the `MONGO_URI` is correctly formatted with the `authSource` and verify the Secret values are properly referenced.  \n\ntool_call:  \n{\n  "tool": "exec_kubectl_cmd_safely",\n  "args": {\n    "command": "kubectl apply -f - <<EOF\\napiVersion: apps/v1\\nkind: Deployment\\nmetadata:\\n  name: geo\\n  namespace: hotel-reservation\\nspec:\\n  template:\\n    spec:\\n      containers:\\n      - name: hotel-reserv-geo\\n        env:\\n        - name: MONGO_URI\\n          value: \\"mongodb://${MONGO_USER}:${MONGO_PASS}@mongodb-geo:27017?authSource=${MONGO_AUTHDB}\\"\\n        - name: MONGO_USER\\n          valueFrom:\\n            secretKeyRef:\\n              name: mongodb-geo-auth\\n              key: username\\n        - name: MONGO_PASS\\n          valueFrom:\\n            secretKeyRef:\\n              name: mongodb-geo-auth\\n              key: password\\n        - name: MONGO_AUTHDB\\n          valueFrom:\\n            secretKeyRef:\\n              name: mongodb-geo-auth\\n              key: authdb\\nEOF"\n  }\n}', additional_kwargs={'provider_specific_fields': {'reasoning': None, 'refusal': None}}, response_metadata={'token_usage': Usage(completion_tokens=843, prompt_tokens=11683, total_tokens=12526, completion_tokens_details=None, prompt_tokens_details=None), 'model': 'openai/Qwen/Qwen3-8B', 'finish_reason': 'stop', 'logprobs': None, 'model_name': 'openai/Qwen/Qwen3-8B'}, id='lc_run--019cfb3e-8cd1-78b2-a085-a833db75ddb6-0', tool_calls=[], invalid_tool_calls=[], usage_metadata={'input_tokens': 11683, 'output_tokens': 843, 'total_tokens': 12526}), HumanMessage(content='Now generate a tool call according to your last chosen tool.', additional_kwargs={}, response_metadata={}, id='15a0a731-b3b6-4623-9e19-4302aed110e7')]]
