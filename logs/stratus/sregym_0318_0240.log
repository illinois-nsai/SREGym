ry.io/name=ad"}}\n</tool_call>', additional_kwargs={'provider_specific_fields': {'reasoning': None, 'refusal': None}}, response_metadata={'token_usage': Usage(completion_tokens=370, prompt_tokens=14325, total_tokens=14695, completion_tokens_details=None, prompt_tokens_details=None), 'model': 'openai/Qwen/Qwen3-8B', 'finish_reason': 'stop', 'logprobs': None, 'model_name': 'openai/Qwen/Qwen3-8B'}, id='lc_run--019cfed3-b03e-71f2-b8f3-9aec4968e0db-0', tool_calls=[], invalid_tool_calls=[], usage_metadata={'input_tokens': 14325, 'output_tokens': 370, 'total_tokens': 14695}), HumanMessage(content='Now generate a tool call according to your last chosen tool.', additional_kwargs={}, response_metadata={}, id='818d9d8f-af96-48c2-b897-38140728f71f')]]
