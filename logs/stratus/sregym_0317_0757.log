nal_kwargs={'provider_specific_fields': {'reasoning': None, 'refusal': None}}, response_metadata={'token_usage': Usage(completion_tokens=474, prompt_tokens=16035, total_tokens=16509, completion_tokens_details=None, prompt_tokens_details=None), 'model': 'openai/Qwen/Qwen3-8B', 'finish_reason': 'stop', 'logprobs': None, 'model_name': 'openai/Qwen/Qwen3-8B'}, id='lc_run--019cfad2-9775-7b90-8671-91a8e48dbb6f-0', tool_calls=[], invalid_tool_calls=[], usage_metadata={'input_tokens': 16035, 'output_tokens': 474, 'total_tokens': 16509}), HumanMessage(content='Now generate a tool call according to your last chosen tool.', additional_kwargs={}, response_metadata={}, id='90546c40-9701-4b5d-905e-e1cd67a39925')]]
