, prompt_tokens_details=None), 'model': 'openai/Qwen/Qwen3-8B', 'finish_reason': 'stop', 'logprobs': None, 'model_name': 'openai/Qwen/Qwen3-8B'}, id='lc_run--019cfd27-0ee6-77b2-81be-a3f9850844d9-0', tool_calls=[], invalid_tool_calls=[], usage_metadata={'input_tokens': 9185, 'output_tokens': 473, 'total_tokens': 9658}), HumanMessage(content='Now generate a tool call according to your last chosen tool.', additional_kwargs={}, response_metadata={}, id='61bb1a4f-d21a-4467-93d1-deaf6310c613')]]
