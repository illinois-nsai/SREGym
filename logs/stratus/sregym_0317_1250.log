nction': {'arguments': '{"command": "kubectl get deployments -n astronomy-shop"}', 'name': 'exec_read_only_kubectl_cmd'}, 'id': 'chatcmpl-tool-af21d016b9b7d0be', 'type': 'function'}], 'provider_specific_fields': {'reasoning': None, 'refusal': None}}, response_metadata={'token_usage': {'completion_tokens': 1858, 'prompt_tokens': 2679, 'total_tokens': 4537, 'completion_tokens_details': None, 'prompt_tokens_details': None}, 'model': 'openai/Qwen/Qwen3-8B', 'finish_reason': 'tool_calls', 'logprobs': None, 'model_name': 'openai/Qwen/Qwen3-8B'}, id='lc_run--019cfbd9-c60b-7633-9096-69949fdd50d5-0', tool_calls=[{'name': 'exec_read_only_kubectl_cmd', 'args': {'command': 'kubectl get deployments -n astronomy-shop'}, 'id': 'chatcmpl-tool-af21d016b9b7d0be', 'type': 'tool_call'}], invalid_tool_calls=[], usage_metadata={'input_tokens': 2679, 'output_tokens': 1858, 'total_tokens': 4537}), ToolMessage(content='NAME              READY   UP-TO-DATE   AVAILABLE   AGE\naccounting        1/1     1            1           2m48s\nad                1/1     1            1           2m48s\ncart              1/1     1            1           2m48s\ncheckout          1/1     1            1           2m48s\ncurrency          1/1     1            1           2m48s\nemail             1/1     1            1           2m48s\nflagd             1/1     1            1           2m48s\nfraud-detection   1/1     1            1           2m48s\nfrontend          0/2     2            0           54s\nfrontend-proxy    1/1     1            1           2m48s\ngrafana           1/1     1            1           2m48s\nimage-provider    1/1     1            1           2m48s\njaeger            1/1     1            1           2m48s\nkafka             1/1     1            1           2m48s\nllm               1/1     1            1           2m48s\nload-generator    1/1     1            1           2m48s\npayment           1/1     1            1           2m48s\npostgresql        1/1     1            1           2