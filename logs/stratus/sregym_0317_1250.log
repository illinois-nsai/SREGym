alue\': \'go1.24.11\'}, {\'key\': \'service.instance.id\', \'type\': \'string\', \'value\': \'astronomy-shop.product-catalog-f57789b6d-jcdxz.product-catalog\'}, {\'key\': \'service.namespace\', \'type\': \'string\', \'value\': \'otel-demo\'}, {\'key\': \'service.version\', \'type\': \'string\', \'value\': \'2.2.0\'}, {\'key\': \'telemetry.sdk.language\', \'type\': \'string\', \'value\': \'go\'}, {\'key\': \'telemetry.sdk.name\', \'type\': \'string\', \'value\': \'opentelemetry\'}, {\'key\': \'telemetry.sdk.version\', \'type\': \'string\', \'value\': \'1.39.0\'}]}, \'p3\': {\'serviceName\': \'frontend-proxy\', \'tags\': [{\'key\': \'container.image.name\', \'type\': \'string\', \'value\': \'ghcr.io/open-telemetry/demo\'}, {\'key\': \'container.image.tag\', \'type\': \'string\', \'value\': \'2.2.0-frontend-proxy\'}, {\'key\': \'host.name\', \'type\': \'string\', \'value\': \'otel-collector-agent-prrtv\'}, {\'key\': \'k8s.cluster.uid\', \'type\': \'string\', \'value\': \'bcd5933a-ce7f-4f9a-9e53-34ae371b7423\'}, {\'key\': \'k8s.container.name\', \'type\': \'string\', \'value\': \'frontend-proxy\'}, {\'key\': \'k8s.deployment.name\', \'type\': \'string\', \'value\': \'frontend-proxy\'}, {\'key\': \'k8s.namespace.name\', \'type\': \'string\', \'value\': \'astronomy-shop\'}, {\'key\': \'k8s.node.name\', \'type\': \'string\', \'value\': \'node0.htliang2-agent.insai-pg0.apt.emulab.net\'}, {\'key\': \'k8s.pod.name\', \'type\': \'string\', \'value\': \'frontend-proxy-84788b44b-h2lj5\'}, {\'key\': \'k8s.pod.start_time\', \'type\': \'string\', \'value\': \'2026-03-17T12:48:56Z\'}, {\'key\': \'k8s.pod.uid\', \'type\': \'string\', \'value\': \'0b7045ee-83b3-449f-8a11-a6390b6f377c\'}, {\'key\': \'k8s.replicaset.name\', \'type\': \'string\', \'value\': \'frontend-proxy-84788b44b\'}, {\'key\': \'k8s.replicaset.uid\', \'type\': \'string\', \'value\': \'203f3c00-b9cb-42c6-ab03-cb6cb37ced36\'}, {\'key\': \'os.type\', \'type\': \'string\', \'value\': \'linux\'}, {\'key\': \'otel.library.