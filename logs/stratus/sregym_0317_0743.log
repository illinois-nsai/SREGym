 None}}, response_metadata={'token_usage': {'completion_tokens': 273, 'prompt_tokens': 3654, 'total_tokens': 3927, 'completion_tokens_details': None, 'prompt_tokens_details': None}, 'model': 'openai/Qwen/Qwen3-8B', 'finish_reason': 'tool_calls', 'logprobs': None, 'model_name': 'openai/Qwen/Qwen3-8B'}, id='lc_run--019cfac0-b287-7b73-b6b5-9b9390acacf7-0', tool_calls=[{'name': 'exec_read_only_kubectl_cmd', 'args': {'command': 'kubectl get deployments -n hotel-reservation'}, 'id': 'chatcmpl-tool-ab136eea8b46ac3f', 'type': 'tool_call'}], invalid_tool_calls=[], usage_metadata={'input_tokens': 3654, 'output_tokens': 273, 'total_tokens': 3927}), ToolMessage(content='NAME                     READY   UP-TO-DATE   AVAILABLE   AGE\nconsul                   1/1     1            1           3m19s\nfrontend                 0/1     1            0           3m19s\ngeo                      0/1     1            0           3m18s\njaeger                   1/1     1            1           3m15s\nmemcached-profile        1/1     1            1           3m13s\nmemcached-rate           1/1     1            1           3m8s\nmemcached-reserve        1/1     1            1           2m56s\nmongodb-geo              1/1     1            1           3m17s\nmongodb-profile          1/1     1            1           3m11s\nmongodb-rate             1/1     1            1           3m6s\nmongodb-recommendation   1/1     1            1           3m1s\nmongodb-reservation      1/1     1            1           2m53s\nmongodb-user             1/1     1            1           2m43s\nprofile                  0/1     1            0           3m10s\nrate                     0/1     1            0           3m4s\nrecommendation           0/1     1            0           2m59s\nreservation              0/1     1            0           2m50s\nsearch                   0/1     1            0           2m46s\nuser                     0/1     1            0           2m41s\n', id='91708b5a-36c2-4846-bf01-d129d03f