{
  "tool": "exec_kubectl_cmd_safely",
  "args": {
    "command": "kubectl apply -f - <<EOF\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: geo\n  namespace: hotel-reservation\nspec:\n  template:\n    spec:\n      containers:\n      - name: hotel-reserv-geo\n        env:\n        - name: MONGO_URI\n          value: \"mongodb://\$MONGO_USER:\$MONGO_PASS@mongodb-geo:27017?authSource=\$MONGO_AUTHDB\"\n        - name: MONGO_USER\n          valueFrom:\n            secretKeyRef:\n              name: mongodb-geo-auth\n              key: username\n        - name: MONGO_PASS\n          valueFrom:\n            secretKeyRef:\n              name: mongodb-geo-auth\n              key: password\n        - name: MONGO_AUTHDB\n          valueFrom:\n            secretKeyRef:\n              name: mongodb-geo-auth\n              key: authdb\nEOF"
