{'key': 'client.address', 'type': 'string', 'value': '10.244.0.178'}, {'key': 'server.address', 'type': 'string', 'value': 'shipping'}, {'key': 'server.port', 'type': 'int64', 'value': 8080}, {'key': 'url.path', 'type': 'string', 'value': '/get-quote'}, {'key': 'url.scheme', 'type': 'string', 'value': 'http'}, {'key': 'http.request.method', 'type': 'string', 'value': 'POST'}, {'key': 'network.protocol.version', 'type': 'string', 'value': '1.1'}, {'key': 'messaging.message.body.size', 'type': 'int64', 'value': 174}, {'key': 'user_agent.original', 'type': 'string', 'value': 'Go-http-client/1.1'}, {'key': 'app.shipping.cost.total', 'type': 'string', 'value': '35.96'}, {'key': 'http.response.status_code', 'type': 'int64', 'value': 200}, {'key': 'unsanitized_span_name', 'type': 'string', 'value': '/get-quote'}, {'key': 'span.kind', 'type': 'string', 'value': 'server'}, {'key': 'internal.span.format', 'type': 'string', 'value': 'otlp'}], 'logs': [{'timestamp': 1773763229779864, 'fields': [{'key': 'event', 'type': 'string', 'value': 'Received Quote'}, {'key': 'app.shipping.cost.total', 'type': 'string', 'value': '35.96'}]}], 'processID': 'p11', 'warnings': None}, {'traceID': '6f5d14f94297272e3cf5a552226180a2', 'spanID': 'e159884e6fd08a44', 'operationName': 'POST /ship-order', 'references': [{'refType': 'CHILD_OF', 'traceID': '6f5d14f94297272e3cf5a552226180a2', 'spanID': 'e8c4f93a2e4036cd'}], 'startTime': 1773763229792874, 'duration': 190, 'tags': [{'key': 'http.route', 'type': 'string', 'value': '/ship-order'}, {'key': 'client.address', 'type': 'string', 'value': '10.244.0.178'}, {'key': 'server.address', 'type': 'string', 'value': 'shipping'}, {'key': 'server.port', 'type': 'int64', 'value': 8080}, {'key': 'url.path', 'type': 'string', 'value': '/ship-order'}, {'key': 'url.scheme', 'type': 'string', 'value': 'http'}, {'key': 'http.request.method', 'type': 'string', 'value': 'POST'}, {'key': 'network.protocol.version', 'type': 'string', 'value':", id='b14b1467-8171-4478-a4af-bf6629dd74c8', tool_call_id='chatcmpl-tool-a1f0f6cc569c1271'), HumanMessage(content='You are now in the thinking stage. Choose a tool from the available tools and justify your choice.', additional_kwargs={}, response_metadata={}, id='d572a2b3-0ff5-4854-8444-5b285db8de96')]]
