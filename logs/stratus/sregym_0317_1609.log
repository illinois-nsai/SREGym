bectl_cmd_safely",\n  "args": {\n    "command": "kubectl get pods -n hotel-reservation | grep rate"\n  }\n}', additional_kwargs={'provider_specific_fields': {'reasoning': None, 'refusal': None}}, response_metadata={'token_usage': Usage(completion_tokens=446, prompt_tokens=14772, total_tokens=15218, completion_tokens_details=None, prompt_tokens_details=None), 'model': 'openai/Qwen/Qwen3-8B', 'finish_reason': 'stop', 'logprobs': None, 'model_name': 'openai/Qwen/Qwen3-8B'}, id='lc_run--019cfc94-dd3e-7320-91ef-e61428979d6f-0', tool_calls=[], invalid_tool_calls=[], usage_metadata={'input_tokens': 14772, 'output_tokens': 446, 'total_tokens': 15218}), HumanMessage(content='Now generate a tool call according to your last chosen tool.', additional_kwargs={}, response_metadata={}, id='dc91107e-4b53-4357-bb22-c0bed8fd29f4')]]
