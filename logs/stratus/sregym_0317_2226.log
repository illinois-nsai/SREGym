gs={'provider_specific_fields': {'refusal': None, 'reasoning': None}}, response_metadata={'token_usage': Usage(completion_tokens=558, prompt_tokens=2912, total_tokens=3470, completion_tokens_details=None, prompt_tokens_details=None), 'model': 'openai/Qwen/Qwen3-8B', 'finish_reason': 'stop', 'logprobs': None, 'model_name': 'openai/Qwen/Qwen3-8B'}, id='lc_run--019cfde9-5edb-79e0-be98-14bc3841a2bb-0', tool_calls=[], invalid_tool_calls=[], usage_metadata={'input_tokens': 2912, 'output_tokens': 558, 'total_tokens': 3470}), HumanMessage(content='Now generate a tool call according to your last chosen tool.', additional_kwargs={}, response_metadata={}, id='f9649a44-7a15-431d-ba77-e9c71df4ed4f')]]
